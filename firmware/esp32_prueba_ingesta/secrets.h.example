#pragma once

#define WIFI_SSID      "NOMBRE_DE_TU_WIFI"     // red de 2.4 GHz (el ESP32 no usa 5 GHz)
#define WIFI_PASSWORD  "CLAVE_DE_TU_WIFI"

// Direccion IP del computador donde corre el concentrador (NO uses "localhost" ni 127.0.0.1:
// para el ESP32 eso seria el propio ESP32). Windows: ipconfig; Linux/Mac: ip addr / ifconfig.
#define CONCENTRADOR_URL  "http://192.168.1.50:8000/v1/eventos"

// Punto de ordeno que simula esta prueba (R1..R5 o L1..L5).
#define ESTACION_ID    "R1"
