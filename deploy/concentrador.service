# Servicio systemd para el concentrador (Raspberry Pi / mini-PC Linux). Ajustar usuario y rutas.
#   sudo cp deploy/concentrador.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now concentrador
#   journalctl -u concentrador -f      # ver registros
# Al volver la energia el servicio arranca solo y revisa las sesiones que quedaron abiertas (G-13).
[Unit]
Description=Concentrador CIC Santa Maria del Puyon
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/plataforma-cic
ExecStart=/home/pi/plataforma-cic/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
