# Copiar a .env y ajustar. El archivo .env no se versiona. Todas las variables son opcionales.
APP_ENV=development
DATABASE_URL=sqlite:///./concentrador.db
TZ=America/Bogota
UMBRAL_CONFIANZA_ANIMAL=0.80

# El nodo envia una lectura parcial cada tantos segundos durante el ordeno.
INTERVALO_LECTURA_PARCIAL_SEG=120
# Una sesion EN_CURSO sin lecturas nuevas por tanto tiempo pasa a INCONCLUSA (por defecto: 3 intervalos).
# SESION_TIMEOUT_SEG=360
# Cada cuanto revisa el concentrador si hay sesiones cortadas.
BARRIDO_SEG=60

# Tipo de medidor de cada punto de ordeno (la sala tiene 6 Allflex y 4 Waikato; la letra R/L NO lo indica).
# Hasta confirmar el mapa real con la finca, un punto no listado queda SIN_DEFINIR.
# PUNTOS_WAIKATO=
# PUNTOS_ALLFLEX=
